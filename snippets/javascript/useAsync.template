export function useAsync(callback, dependencies = []) {
    const [state, setState] = useState({
        loading: true,
        error: undefined,
        value: undefined,
    });

    useEffect(() => {
        let isMounted = true;

        // Reset state for new request
        setState({
            loading: true,
            error: undefined,
            value: undefined,
        });

        callback()
            .then((value) => {
                if (isMounted) {
                    setState({
                        loading: false,
                        error: undefined,
                        value,
                    });
                }
            })
            .catch((error) => {
                if (isMounted) {
                    setState({
                        loading: false,
                        error: error instanceof Error ? error : new Error(String(error)),
                        value: undefined,
                    });
                }
            });

        return () => {
            isMounted = false;
        };
    }, dependencies); // eslint-disable-line react-hooks/exhaustive-deps

    return state;
}